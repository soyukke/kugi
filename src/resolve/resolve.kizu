import kugi::bytes;
import kugi::lockfile;
import kugi::manifest;
import kugi::store;
import std::array;
import std::map;
import std::mem;
import std::path;
import std::sort;
import std::string;
import std::testing;

pub error Error {
    UsageError,
    ManifestInvalid,
    Unlocked,
    IoFailed,
    OutOfMemory,
}

pub enum ShellKind {
    Posix,
    Fish,
}

fn strings_equal(a: &string::String, b: &string::String) -> bool {
    let ab = a.as_bytes();
    let bb = b.as_bytes();
    return mem::equal_bytes(ab, bb);
}

pub fn resolve_user_path(
    allocator: Allocator,
    raw: []u8,
    home_dir: []u8,
    base_dir: []u8,
    out: &var string::String,
) -> Error!void {
    var expanded = string::new(allocator);
    defer expanded.deinit(allocator);
    bytes::expand_tilde(allocator, raw, home_dir, &var expanded) catch return Error::OutOfMemory;
    let eb = expanded.as_bytes();
    if mem::len(eb) > 0 and eb[0] == cast<u8>(47) {
        let cleaned = path::clean(allocator, eb) catch return Error::OutOfMemory;
        defer cleaned.deinit(allocator);
        let cb = cleaned.as_bytes();
        out.append_bytes(allocator, cb) catch return Error::OutOfMemory;
        return;
    }
    let joined = path::join(allocator, base_dir, eb) catch return Error::OutOfMemory;
    defer joined.deinit(allocator);
    let jb = joined.as_bytes();
    out.append_bytes(allocator, jb) catch return Error::OutOfMemory;
    return;
}

pub fn resolve_tool_lock(
    allocator: Allocator,
    tool: &manifest::ToolSpec,
    lf: &lockfile::Lockfile,
    os: []u8,
    arch: []u8,
    out_url: &var string::String,
    out_sha: &var string::String,
) -> Error!bool {
    out_url.clear();
    out_sha.clear();
    if tool.has_sha256 {
        manifest::resolve_tool_url(allocator, tool, os, arch, out_url) catch return Error::OutOfMemory;
        let sb = tool.sha256.as_bytes();
        out_sha.append_bytes(allocator, sb) catch return Error::OutOfMemory;
        return true;
    }
    var target_key = string::new(allocator);
    defer target_key.deinit(allocator);
    target_key.append_bytes(allocator, os) catch return Error::OutOfMemory;
    target_key.append_byte(allocator, cast<u8>(45)) catch return Error::OutOfMemory;
    target_key.append_bytes(allocator, arch) catch return Error::OutOfMemory;
    let tkb = target_key.as_bytes();
    let tname = tool.name.as_bytes();
    let tver = tool.version.as_bytes();
    let matched = lockfile::lookup_target(allocator, lf, tname, tver, tkb, out_url, out_sha) catch return Error::OutOfMemory;
    if !matched {
        return false;
    }
    var expected_url = string::new(allocator);
    defer expected_url.deinit(allocator);
    manifest::resolve_tool_url(allocator, tool, os, arch, &var expected_url) catch return Error::OutOfMemory;
    if !strings_equal(&expected_url, out_url) {
        out_url.clear();
        out_sha.clear();
        return false;
    }
    return true;
}

pub fn resolve_asset_lock(
    allocator: Allocator,
    asset: &manifest::AssetSpec,
    lf: &lockfile::Lockfile,
    os: []u8,
    arch: []u8,
    out_url: &var string::String,
    out_sha: &var string::String,
) -> Error!bool {
    out_url.clear();
    out_sha.clear();
    if asset.has_sha256 {
        manifest::resolve_asset_url(allocator, asset, os, arch, out_url) catch return Error::OutOfMemory;
        let sb = asset.sha256.as_bytes();
        out_sha.append_bytes(allocator, sb) catch return Error::OutOfMemory;
        return true;
    }
    var target_key = string::new(allocator);
    defer target_key.deinit(allocator);
    target_key.append_bytes(allocator, os) catch return Error::OutOfMemory;
    target_key.append_byte(allocator, cast<u8>(45)) catch return Error::OutOfMemory;
    target_key.append_bytes(allocator, arch) catch return Error::OutOfMemory;
    let tkb = target_key.as_bytes();
    let aname = asset.name.as_bytes();
    let aver = asset.version.as_bytes();
    let matched = lockfile::lookup_asset_target(allocator, lf, aname, aver, tkb, out_url, out_sha) catch return Error::OutOfMemory;
    if !matched {
        return false;
    }
    var expected_url = string::new(allocator);
    defer expected_url.deinit(allocator);
    manifest::resolve_asset_url(allocator, asset, os, arch, &var expected_url) catch return Error::OutOfMemory;
    if !strings_equal(&expected_url, out_url) {
        out_url.clear();
        out_sha.clear();
        return false;
    }
    return true;
}

pub fn collect_known_paths(
    allocator: Allocator,
    paths: &store::Paths,
    m: &manifest::Manifest,
    lf: &lockfile::Lockfile,
    manifest_dir: []u8,
    os: []u8,
    arch: []u8,
    out_tool_paths: &var map::Map<[]u8, string::String>,
    out_asset_paths: &var map::Map<[]u8, string::String>,
) -> Error!void {
    let home_b = paths.home_dir.as_bytes();
    let sd = paths.store_dir.as_bytes();

    var ti = 0;
    while m.tools.at(ti) |tool| {
        let tname = tool.name.as_bytes();
        if tool.mode == manifest::InstallMode::Bootstrap {
            var install_dir = string::new(allocator);
            defer install_dir.deinit(allocator);
            let raw_dir = tool.install_dir.as_bytes();
            try resolve_user_path(allocator, raw_dir, home_b, manifest_dir, &var install_dir);
            let idb = install_dir.as_bytes();
            let tp_copy = string::from_bytes(allocator, idb) catch return Error::OutOfMemory;
            out_tool_paths.insert(allocator, tname, move tp_copy) catch return Error::OutOfMemory;
        } else {
            var url = string::new(allocator);
            defer url.deinit(allocator);
            var sha = string::new(allocator);
            defer sha.deinit(allocator);
            if try resolve_tool_lock(allocator, tool, lf, os, arch, &var url, &var sha) {
                let ub = url.as_bytes();
                let sb = sha.as_bytes();
                var key = string::new(allocator);
                defer key.deinit(allocator);
                store::format_tool_store_key(allocator, tool, ub, sb, &var key) catch return Error::OutOfMemory;
                let kb = key.as_bytes();
                var store_dir = path::join(allocator, sd, kb) catch return Error::OutOfMemory;
                defer store_dir.deinit(allocator);
                let sdb = store_dir.as_bytes();
                let tp_copy = string::from_bytes(allocator, sdb) catch return Error::OutOfMemory;
                out_tool_paths.insert(allocator, tname, move tp_copy) catch return Error::OutOfMemory;
            }
        }
        ti = ti + 1;
    }

    var ai = 0;
    while m.assets.at(ai) |asset| {
        var url = string::new(allocator);
        defer url.deinit(allocator);
        var sha = string::new(allocator);
        defer sha.deinit(allocator);
        if try resolve_asset_lock(allocator, asset, lf, os, arch, &var url, &var sha) {
            let aname = asset.name.as_bytes();
            let ub = url.as_bytes();
            let sb = sha.as_bytes();
            var key = string::new(allocator);
            defer key.deinit(allocator);
            store::format_asset_store_key(allocator, asset, ub, sb, &var key) catch return Error::OutOfMemory;
            let kb = key.as_bytes();
            var store_dir = path::join(allocator, sd, kb) catch return Error::OutOfMemory;
            defer store_dir.deinit(allocator);
            let sdb = store_dir.as_bytes();
            let ap_copy = string::from_bytes(allocator, sdb) catch return Error::OutOfMemory;
            out_asset_paths.insert(allocator, aname, move ap_copy) catch return Error::OutOfMemory;
        }
        ai = ai + 1;
    }
    return;
}

pub fn append_shell_quoted(
    allocator: Allocator,
    shell: ShellKind,
    value: []u8,
    out: &var string::String,
) -> mem::Error!void {
    try out.append_byte(allocator, cast<u8>(39));
    let length = mem::len(value);
    var i = 0;
    while i < length {
        let b = value[i];
        if shell == ShellKind::Fish {
            if b == cast<u8>(39) or b == cast<u8>(92) {
                try out.append_byte(allocator, cast<u8>(92));
            }
            try out.append_byte(allocator, b);
        } else {
            if b == cast<u8>(39) {
                try out.append_byte(allocator, cast<u8>(39));
                try out.append_byte(allocator, cast<u8>(92));
                try out.append_byte(allocator, cast<u8>(39));
                try out.append_byte(allocator, cast<u8>(39));
            } else {
                try out.append_byte(allocator, b);
            }
        }
        i = i + 1;
    }
    try out.append_byte(allocator, cast<u8>(39));
    return;
}

pub fn expand_placeholders(
    allocator: Allocator,
    raw: []u8,
    home_dir: []u8,
    manifest_dir: []u8,
    tool_paths: &map::Map<[]u8, string::String>,
    asset_paths: &map::Map<[]u8, string::String>,
    m: &manifest::Manifest,
    out: &var string::String,
    diag: &var string::String,
) -> Error!void {
    if mem::equal_bytes(raw, "~") {
        out.append_bytes(allocator, home_dir) catch return Error::OutOfMemory;
        return;
    }
    var start: i64 = 0;
    if mem::starts_with(raw, "~/") {
        let hlen = mem::len(home_dir);
        if hlen > 0 and home_dir[hlen - 1] == cast<u8>(47) {
            out.append_bytes(allocator, home_dir[0..hlen - 1]) catch return Error::OutOfMemory;
        } else {
            out.append_bytes(allocator, home_dir) catch return Error::OutOfMemory;
        }
        start = 1;
    }
    let length = mem::len(raw);
    var i = start;
    while i < length {
        if i + 14 <= length and mem::equal_bytes(raw[i..i + 14], "{manifest_dir}") {
            out.append_bytes(allocator, manifest_dir) catch return Error::OutOfMemory;
            i = i + 14;
        } else if i + 7 <= length and mem::equal_bytes(raw[i..i + 7], "{asset.") {
            if bytes::index_of_byte(raw, cast<u8>(125), i + 7) |close| {
                let name = raw[i + 7..close];
                if mem::len(name) == 0 {
                    diag.clear();
                    diag.append_bytes(allocator, "empty asset name in '{asset.}' placeholder") catch return Error::OutOfMemory;
                    return Error::ManifestInvalid;
                }
                if asset_paths.at(name) |resolved| {
                    let rb = resolved.as_bytes();
                    out.append_bytes(allocator, rb) catch return Error::OutOfMemory;
                    i = close + 1;
                } else if manifest::find_asset_index(m, name) |_| {
                    diag.clear();
                    diag.append_bytes(allocator, "asset '") catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, name) catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, "' is not locked for this platform; run `kugi lock` and `kugi sync`") catch return Error::OutOfMemory;
                    return Error::Unlocked;
                } else {
                    diag.clear();
                    diag.append_bytes(allocator, "unknown asset '") catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, name) catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, "' referenced in placeholder") catch return Error::OutOfMemory;
                    return Error::ManifestInvalid;
                }
            } else {
                diag.clear();
                diag.append_bytes(allocator, "unterminated '{asset.' placeholder") catch return Error::OutOfMemory;
                return Error::ManifestInvalid;
            }
        } else if i + 6 <= length and mem::equal_bytes(raw[i..i + 6], "{tool.") {
            if bytes::index_of_byte(raw, cast<u8>(125), i + 6) |close| {
                let name = raw[i + 6..close];
                if mem::len(name) == 0 {
                    diag.clear();
                    diag.append_bytes(allocator, "empty tool name in '{tool.}' placeholder") catch return Error::OutOfMemory;
                    return Error::ManifestInvalid;
                }
                if tool_paths.at(name) |resolved| {
                    let rb = resolved.as_bytes();
                    out.append_bytes(allocator, rb) catch return Error::OutOfMemory;
                    i = close + 1;
                } else if manifest::find_tool_index(m, name) |_| {
                    diag.clear();
                    diag.append_bytes(allocator, "tool '") catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, name) catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, "' is not locked for this platform; run `kugi lock` and `kugi sync`") catch return Error::OutOfMemory;
                    return Error::Unlocked;
                } else {
                    diag.clear();
                    diag.append_bytes(allocator, "unknown tool '") catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, name) catch return Error::OutOfMemory;
                    diag.append_bytes(allocator, "' referenced in placeholder") catch return Error::OutOfMemory;
                    return Error::ManifestInvalid;
                }
            } else {
                diag.clear();
                diag.append_bytes(allocator, "unterminated '{tool.' placeholder") catch return Error::OutOfMemory;
                return Error::ManifestInvalid;
            }
        } else {
            out.append_byte(allocator, raw[i]) catch return Error::OutOfMemory;
            i = i + 1;
        }
    }
    return;
}

pub fn expand_env_prepend_values(
    allocator: Allocator,
    values: &array::Array<string::String>,
    home_dir: []u8,
    manifest_dir: []u8,
    tool_paths: &map::Map<[]u8, string::String>,
    asset_paths: &map::Map<[]u8, string::String>,
    m: &manifest::Manifest,
    out_joined: &var string::String,
    diag: &var string::String,
) -> Error!void {
    out_joined.clear();
    var i = 0;
    while values.at(i) |item| {
        if i > 0 {
            out_joined.append_byte(allocator, cast<u8>(58)) catch return Error::OutOfMemory;
        }
        let raw = item.as_bytes();
        try expand_placeholders(allocator, raw, home_dir, manifest_dir, tool_paths, asset_paths, m, out_joined, diag);
        i = i + 1;
    }
    return;
}

pub fn append_posix_env_prepend_line(
    allocator: Allocator,
    key: []u8,
    prefix_value: []u8,
    out: &var string::String,
) -> mem::Error!void {
    try out.append_bytes(allocator, "export ");
    try out.append_bytes(allocator, key);
    try out.append_byte(allocator, cast<u8>(61));
    try append_shell_quoted(allocator, ShellKind::Posix, prefix_value, out);
    try out.append_bytes(allocator, "${");
    try out.append_bytes(allocator, key);
    try out.append_bytes(allocator, ":+:");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_byte(allocator, cast<u8>(36));
    try out.append_bytes(allocator, key);
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_byte(allocator, cast<u8>(125));
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

pub fn render_wrapper_script(
    allocator: Allocator,
    wrapper: &manifest::WrapperSpec,
    home_dir: []u8,
    manifest_dir: []u8,
    tool_paths: &map::Map<[]u8, string::String>,
    asset_paths: &map::Map<[]u8, string::String>,
    m: &manifest::Manifest,
    out_script: &var string::String,
    diag: &var string::String,
) -> Error!void {
    out_script.clear();
    out_script.append_bytes(allocator, "#!/bin/sh") catch return Error::OutOfMemory;
    out_script.append_byte(allocator, cast<u8>(10)) catch return Error::OutOfMemory;

    var env_keys = array::new<string::String>(allocator);
    defer env_keys.deinit(allocator);
    var ki = 0;
    while wrapper.env.key_at(ki) |k| {
        let copy = string::from_bytes(allocator, k) catch return Error::OutOfMemory;
        env_keys.append(allocator, move copy) catch return Error::OutOfMemory;
        ki = ki + 1;
    }
    sort::strings(&var env_keys) catch return Error::IoFailed;

    var ei = 0;
    while env_keys.at(ei) |k_str| {
        let k = k_str.as_bytes();
        if wrapper.env.at(k) |v_str| {
            let v_raw = v_str.as_bytes();
            var expanded = string::new(allocator);
            defer expanded.deinit(allocator);
            try expand_placeholders(allocator, v_raw, home_dir, manifest_dir, tool_paths, asset_paths, m, &var expanded, diag);
            let eb = expanded.as_bytes();
            out_script.append_bytes(allocator, "export ") catch return Error::OutOfMemory;
            out_script.append_bytes(allocator, k) catch return Error::OutOfMemory;
            out_script.append_byte(allocator, cast<u8>(61)) catch return Error::OutOfMemory;
            append_shell_quoted(allocator, ShellKind::Posix, eb, out_script) catch return Error::OutOfMemory;
            out_script.append_byte(allocator, cast<u8>(10)) catch return Error::OutOfMemory;
        }
        ei = ei + 1;
    }

    var prepend_keys = array::new<string::String>(allocator);
    defer prepend_keys.deinit(allocator);
    var pki = 0;
    while wrapper.env_prepend.key_at(pki) |k| {
        let copy = string::from_bytes(allocator, k) catch return Error::OutOfMemory;
        prepend_keys.append(allocator, move copy) catch return Error::OutOfMemory;
        pki = pki + 1;
    }
    sort::strings(&var prepend_keys) catch return Error::IoFailed;

    var pi = 0;
    while prepend_keys.at(pi) |k_str| {
        let k = k_str.as_bytes();
        if wrapper.env_prepend.at(k) |v_str| {
            let v_raw = v_str.as_bytes();
            var expanded = string::new(allocator);
            defer expanded.deinit(allocator);
            try expand_placeholders(allocator, v_raw, home_dir, manifest_dir, tool_paths, asset_paths, m, &var expanded, diag);
            let eb = expanded.as_bytes();
            append_posix_env_prepend_line(allocator, k, eb, out_script) catch return Error::OutOfMemory;
        }
        pi = pi + 1;
    }

    var exec_expanded = string::new(allocator);
    defer exec_expanded.deinit(allocator);
    let exec_raw = wrapper.exec.as_bytes();
    try expand_placeholders(allocator, exec_raw, home_dir, manifest_dir, tool_paths, asset_paths, m, &var exec_expanded, diag);
    let exb = exec_expanded.as_bytes();

    out_script.append_bytes(allocator, "exec ") catch return Error::OutOfMemory;
    append_shell_quoted(allocator, ShellKind::Posix, exb, out_script) catch return Error::OutOfMemory;

    var ai = 0;
    while wrapper.args.at(ai) |arg_str| {
        let a_raw = arg_str.as_bytes();
        var expanded = string::new(allocator);
        defer expanded.deinit(allocator);
        try expand_placeholders(allocator, a_raw, home_dir, manifest_dir, tool_paths, asset_paths, m, &var expanded, diag);
        let ab = expanded.as_bytes();
        out_script.append_byte(allocator, cast<u8>(32)) catch return Error::OutOfMemory;
        append_shell_quoted(allocator, ShellKind::Posix, ab, out_script) catch return Error::OutOfMemory;
        ai = ai + 1;
    }

    out_script.append_byte(allocator, cast<u8>(32)) catch return Error::OutOfMemory;
    out_script.append_byte(allocator, cast<u8>(34)) catch return Error::OutOfMemory;
    out_script.append_bytes(allocator, "$@") catch return Error::OutOfMemory;
    out_script.append_byte(allocator, cast<u8>(34)) catch return Error::OutOfMemory;
    out_script.append_byte(allocator, cast<u8>(10)) catch return Error::OutOfMemory;
    return;
}

test "render wrapper script expands placeholders and escapes shell quotes" {
    let allocator = mem::page_allocator();
    let doc =
        \\[tools.node]
        \\version = "24.0.0"
        \\url = "https://example.com/node.tar.gz"
        \\extract = "all"
        \\bin = ["node"]
        \\sha256 = "1111111111111111111111111111111111111111111111111111111111111111"
        \\
        \\[assets.cli_tgz]
        \\version = "1.0.0"
        \\url = "https://registry.npmjs.org/cli/-/cli-1.0.0.tgz"
        \\sha256 = "2222222222222222222222222222222222222222222222222222222222222222"
        \\
        \\[wrappers.my-cli]
        \\exec = "{tool.node}/bin/node"
        \\args = ["{asset.cli_tgz}/dist/cli.js", "--label=it's ok"]
        \\env = { MODE = "prod", CFG = "{manifest_dir}/cfg" }
        \\env_prepend = { NODE_PATH = "{asset.cli_tgz}/node_modules" }
    ;
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    if manifest::parse(allocator, doc, &var diag) |m| {
        defer m.deinit(allocator);
        var paths = store::paths_from_root(allocator, "/kugi", "/test-home", "/cfg/kugi.toml") catch return;
        defer paths.deinit(allocator);
        var lf = lockfile::new_lockfile(allocator);
        defer lf.deinit(allocator);
        var tool_paths = map::new<[]u8, string::String>(allocator);
        defer tool_paths.deinit(allocator);
        var asset_paths = map::new<[]u8, string::String>(allocator);
        defer asset_paths.deinit(allocator);
        if collect_known_paths(allocator, &paths, &m, &lf, "/work/proj", "darwin", "aarch64", &var tool_paths, &var asset_paths) {} else |_| {
            testing::fail("collect_known_paths failed");
            return;
        }
        if m.wrappers.at(0) |w| {
            var script = string::new(allocator);
            defer script.deinit(allocator);
            if render_wrapper_script(allocator, w, "/test-home", "/work/proj", &tool_paths, &asset_paths, &m, &var script, &var diag) {
                let sb = script.as_bytes();
                let exp_shebang =
                    \\#!/bin/sh
                    \\export CFG='/work/proj/cfg'
                    \\export MODE='prod'
                ;
                let exp_prepend =
                    \\export NODE_PATH='/kugi/store/asset-2222222222222222/node_modules'${NODE_PATH:+:"$NODE_PATH"}
                ;
                let exp_arg =
                    \\'--label=it'\''s ok' "$@"
                ;
                testing::expect(mem::starts_with(sb, exp_shebang));
                testing::expect(bytes::contains_bytes(sb, exp_prepend));
                testing::expect(bytes::contains_bytes(sb, exp_arg));
            } else |_| {
                testing::fail("render_wrapper_script failed");
            }
        } else {
            testing::fail("missing wrapper");
        }
    } else |_| {
        let msg = diag.as_bytes();
        testing::fail(msg);
    }
}
