import kugi::bytes;
import std::crypto;
import std::mem;
import std::string;
import std::testing;

pub struct Sha256Stream {
    state: [8]u32,
    block: [64]u8,
    filled: i64,
    total_bytes: i64,
}

pub fn sha256_hex(
    allocator: Allocator,
    data: []u8,
    out: &var string::String,
) -> mem::Error!void {
    var digest_buf = [32]u8{};
    let digest = digest_buf.as_mut_bytes();
    crypto::sha256(data, digest);
    let raw = digest_buf.as_bytes();
    try bytes::append_hex_lower(allocator, out, raw);
    return;
}

pub fn sha256_hex_prefix(
    allocator: Allocator,
    data: []u8,
    prefix_len: i64,
    out: &var string::String,
) -> mem::Error!void {
    var full = string::new(allocator);
    defer full.deinit(allocator);
    try sha256_hex(allocator, data, &var full);
    let fb = full.as_bytes();
    var count = prefix_len;
    if count < 0 {
        count = 0;
    }
    if count > mem::len(fb) {
        count = mem::len(fb);
    }
    try out.append_bytes(allocator, fb[0..count]);
    return;
}

pub fn equal_digest(a: []u8, b: []u8) -> bool {
    return crypto::equal_constant_time(a, b);
}

pub fn stream_new() -> Sha256Stream {
    var h = Sha256Stream {
        state: [8]u32{},
        block: [64]u8{},
        filled: 0,
        total_bytes: 0,
    };
    let s = h.state.as_mut_slice();
    s[0] = cast<u32>(1779033703);
    s[1] = cast<u32>(3144134277);
    s[2] = cast<u32>(1013904242);
    s[3] = cast<u32>(2773480762);
    s[4] = cast<u32>(1359893119);
    s[5] = cast<u32>(2600822924);
    s[6] = cast<u32>(528734635);
    s[7] = cast<u32>(1541459225);
    return h;
}

pub fn stream_update(h: &var Sha256Stream, chunk: []u8) -> void {
    let length = mem::len(chunk);
    h.total_bytes = h.total_bytes + length;
    var at = 0;
    let state = h.state.as_mut_slice();
    let block = h.block.as_mut_bytes();
    if h.filled > 0 {
        while h.filled < 64 and at < length {
            block[h.filled] = chunk[at];
            h.filled = h.filled + 1;
            at = at + 1;
        }
        if h.filled == 64 {
            let full = block[0..64];
            compress_block(state, full);
            h.filled = 0;
        }
    }
    while at + 64 <= length {
        let slice = chunk[at..at + 64];
        compress_block(state, slice);
        at = at + 64;
    }
    while at < length {
        block[h.filled] = chunk[at];
        h.filled = h.filled + 1;
        at = at + 1;
    }
    return;
}

pub fn stream_finish_hex(
    allocator: Allocator,
    h: &var Sha256Stream,
    out: &var string::String,
) -> mem::Error!void {
    let state = h.state.as_mut_slice();
    let block = h.block.as_mut_bytes();
    let total_bits = h.total_bytes * 8;
    block[h.filled] = cast<u8>(128);
    var idx = h.filled + 1;
    if h.filled + 9 > 64 {
        while idx < 64 {
            block[idx] = 0;
            idx = idx + 1;
        }
        let full = block[0..64];
        compress_block(state, full);
        idx = 0;
    }
    while idx < 56 {
        block[idx] = 0;
        idx = idx + 1;
    }
    for 0..8 |bi| {
        let shift = (7 - bi) * 8;
        block[56 + bi] = cast<u8>((total_bits >> shift) & 255);
    }
    let last = block[0..64];
    compress_block(state, last);
    var digest_buf = [32]u8{};
    let digest = digest_buf.as_mut_bytes();
    for 0..8 |wi| {
        let v = state[wi];
        let at = wi * 4;
        digest[at] = cast<u8>((v >> 24) & 255);
        digest[at + 1] = cast<u8>((v >> 16) & 255);
        digest[at + 2] = cast<u8>((v >> 8) & 255);
        digest[at + 3] = cast<u8>(v & 255);
    }
    let raw = digest_buf.as_bytes();
    try bytes::append_hex_lower(allocator, out, raw);
    return;
}

fn rotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n));
}

fn word_at(view: []u8, index: i64) -> u32 {
    let at = index * 4;
    return (cast<u32>(view[at]) << 24)
        | (cast<u32>(view[at + 1]) << 16)
        | (cast<u32>(view[at + 2]) << 8)
        | cast<u32>(view[at + 3]);
}

fn fill_k(k: &var []u32) -> void {
    let hex =
        \\428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5
        \\d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174
        \\e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da
        \\983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967
        \\27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85
        \\a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070
        \\19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3
        \\748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2
    ;
    var at = 0;
    var word = cast<u32>(0);
    var digits = 0;
    let length = mem::len(hex);
    var i = 0;
    while i < length {
        let b = cast<i64>(hex[i]);
        var d: i64 = -1;
        if b >= 48 and b <= 57 {
            d = b - 48;
        } else if b >= 97 and b <= 102 {
            d = b - 87;
        }
        if d >= 0 {
            word = (word << 4) | cast<u32>(d);
            digits = digits + 1;
            if digits == 8 {
                k[at] = word;
                at = at + 1;
                word = 0;
                digits = 0;
            }
        }
        i = i + 1;
    }
    return;
}

fn compress_block(state: &var []u32, block: []u8) -> void {
    var schedule_buf = [64]u32{};
    var k_buf = [64]u32{};
    let w = schedule_buf.as_mut_slice();
    let k = k_buf.as_mut_slice();
    fill_k(k);
    for 0..16 |t| {
        w[t] = word_at(block, t);
    }
    for 16..64 |t| {
        let w2 = w[t - 2];
        let w7 = w[t - 7];
        let w15 = w[t - 15];
        let w16 = w[t - 16];
        let s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3);
        let s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10);
        w[t] = w16 + s0 + w7 + s1;
    }
    var a = state[0];
    var b = state[1];
    var c = state[2];
    var d = state[3];
    var e = state[4];
    var f = state[5];
    var g = state[6];
    var h = state[7];
    for 0..64 |t| {
        let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let choose = (e & f) ^ (~e & g);
        let t1 = h + big1 + choose + k[t] + w[t];
        let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        let t2 = big0 + majority;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    state[0] = state[0] + a;
    state[1] = state[1] + b;
    state[2] = state[2] + c;
    state[3] = state[3] + d;
    state[4] = state[4] + e;
    state[5] = state[5] + f;
    state[6] = state[6] + g;
    state[7] = state[7] + h;
    return;
}

test "sha256 oneshot and streaming parity" {
    let allocator = mem::page_allocator();
    var empty_hex = string::new(allocator);
    defer empty_hex.deinit(allocator);
    if sha256_hex(allocator, "", &var empty_hex) {
        let eb = empty_hex.as_bytes();
        testing::expect_equal<[]u8>(
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            eb,
        );
    } else |_| {
        testing::fail("sha256_hex empty failed");
    }

    var abc_hex = string::new(allocator);
    defer abc_hex.deinit(allocator);
    if sha256_hex(allocator, "abc", &var abc_hex) {
        let ab = abc_hex.as_bytes();
        testing::expect_equal<[]u8>(
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
            ab,
        );
    } else |_| {
        testing::fail("sha256_hex abc failed");
    }

    let sample = "The quick brown fox jumps over the lazy dog and crosses a 64-byte SHA-256 block boundary cleanly!";
    var oneshot = string::new(allocator);
    defer oneshot.deinit(allocator);
    if sha256_hex(allocator, sample, &var oneshot) {} else |_| {
        testing::fail("oneshot failed");
        return;
    }

    var st = stream_new();
    stream_update(&var st, sample[0..13]);
    stream_update(&var st, sample[13..56]);
    stream_update(&var st, sample[56..64]);
    stream_update(&var st, sample[64..mem::len(sample)]);
    var streamed = string::new(allocator);
    defer streamed.deinit(allocator);
    if stream_finish_hex(allocator, &var st, &var streamed) {} else |_| {
        testing::fail("stream_finish_hex failed");
        return;
    }
    let ob = oneshot.as_bytes();
    let sb = streamed.as_bytes();
    testing::expect(equal_digest(ob, sb));
}
