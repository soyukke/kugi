import std::fmt;
import std::mem;
import std::string;
import std::testing;

pub fn index_of_byte(bytes: []u8, needle: u8, from: i64) -> ?i64 {
    let length = mem::len(bytes);
    var i = from;
    if i < 0 {
        i = 0;
    }
    while i < length {
        if bytes[i] == needle {
            return i;
        }
        i = i + 1;
    }
    return null;
}

pub fn last_index_of_byte(bytes: []u8, needle: u8) -> ?i64 {
    var i = mem::len(bytes);
    while i > 0 {
        i = i - 1;
        if bytes[i] == needle {
            return i;
        }
    }
    return null;
}

pub fn ends_with(bytes: []u8, suffix: []u8) -> bool {
    let blen = mem::len(bytes);
    let slen = mem::len(suffix);
    if slen > blen {
        return false;
    }
    return mem::equal_bytes(bytes[blen - slen..blen], suffix);
}

pub fn find_bytes(haystack: []u8, needle: []u8, from: i64) -> ?i64 {
    let hlen = mem::len(haystack);
    let nlen = mem::len(needle);
    if nlen == 0 {
        if from < 0 {
            return 0;
        }
        if from > hlen {
            return null;
        }
        return from;
    }
    var i = from;
    if i < 0 {
        i = 0;
    }
    while i + nlen <= hlen {
        if mem::equal_bytes(haystack[i..i + nlen], needle) {
            return i;
        }
        i = i + 1;
    }
    return null;
}

pub fn contains_bytes(haystack: []u8, needle: []u8) -> bool {
    if find_bytes(haystack, needle, 0) |_| {
        return true;
    }
    return false;
}

pub fn append_hex_lower(
    allocator: Allocator,
    out: &var string::String,
    bytes: []u8,
) -> mem::Error!void {
    let length = mem::len(bytes);
    var i = 0;
    while i < length {
        let b = cast<i64>(bytes[i]);
        try out.append_byte(allocator, hex_char_lower(b / 16));
        try out.append_byte(allocator, hex_char_lower(b % 16));
        i = i + 1;
    }
    return;
}

fn hex_char_lower(nibble: i64) -> u8 {
    if nibble < 10 {
        return cast<u8>(48 + nibble);
    }
    return cast<u8>(87 + nibble);
}

pub fn is_valid_sha256_hex(text: []u8) -> bool {
    if mem::len(text) != 64 {
        return false;
    }
    var i = 0;
    while i < 64 {
        let b = text[i];
        let is_digit = b >= cast<u8>(48) and b <= cast<u8>(57);
        let is_lower_hex = b >= cast<u8>(97) and b <= cast<u8>(102);
        if !is_digit and !is_lower_hex {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn parse_nonneg_i64(text: []u8) -> ?i64 {
    let length = mem::len(text);
    if length == 0 {
        return null;
    }
    var value: i64 = 0;
    var i = 0;
    while i < length {
        let b = text[i];
        if b < cast<u8>(48) or b > cast<u8>(57) {
            return null;
        }
        let digit = cast<i64>(b - cast<u8>(48));
        if value > (9223372036854775807 - digit) / 10 {
            return null;
        }
        value = value * 10 + digit;
        i = i + 1;
    }
    return value;
}

fn ascii_upper(b: u8) -> u8 {
    if b >= cast<u8>(97) and b <= cast<u8>(122) {
        return b - cast<u8>(32);
    }
    return b;
}

fn equals_upper(bytes: []u8, expected_upper: []u8) -> bool {
    let length = mem::len(bytes);
    if length != mem::len(expected_upper) {
        return false;
    }
    var i = 0;
    while i < length {
        if ascii_upper(bytes[i]) != expected_upper[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn parse_byte_size(raw: []u8) -> ?i64 {
    let text = mem::trim_ascii(raw);
    let length = mem::len(text);
    if length == 0 {
        return null;
    }
    var split = 0;
    while split < length and text[split] >= cast<u8>(48) and text[split] <= cast<u8>(57) {
        split = split + 1;
    }
    if split == 0 {
        return null;
    }
    let num = parse_nonneg_i64(text[0..split]) orelse return null;
    if num <= 0 {
        return null;
    }
    let unit = mem::trim_ascii(text[split..length]);
    var mult: i64 = 1;
    if mem::len(unit) == 0 or equals_upper(unit, "B") {
        mult = 1;
    } else if equals_upper(unit, "K") or equals_upper(unit, "KB") or equals_upper(unit, "KIB") {
        mult = 1024;
    } else if equals_upper(unit, "M") or equals_upper(unit, "MB") or equals_upper(unit, "MIB") {
        mult = 1024 * 1024;
    } else if equals_upper(unit, "G") or equals_upper(unit, "GB") or equals_upper(unit, "GIB") {
        mult = 1024 * 1024 * 1024;
    } else if equals_upper(unit, "T") or equals_upper(unit, "TB") or equals_upper(unit, "TIB") {
        mult = 1024 * 1024 * 1024 * 1024;
    } else {
        return null;
    }
    if num > 9223372036854775807 / mult {
        return null;
    }
    return num * mult;
}

pub fn format_byte_size(
    allocator: Allocator,
    out: &var string::String,
    size: i64,
) -> mem::Error!void {
    if size < 1024 {
        try fmt::append_i64(allocator, out, size);
        try out.append_bytes(allocator, " B");
        return;
    }
    let kib: i64 = 1024;
    let mib: i64 = 1024 * 1024;
    let gib: i64 = 1024 * 1024 * 1024;
    if size < mib {
        try append_scaled(allocator, out, size, kib, " KB");
        return;
    }
    if size < gib {
        try append_scaled(allocator, out, size, mib, " MB");
        return;
    }
    try append_scaled(allocator, out, size, gib, " GB");
    return;
}

fn append_scaled(
    allocator: Allocator,
    out: &var string::String,
    size: i64,
    unit: i64,
    suffix: []u8,
) -> mem::Error!void {
    let whole = size / unit;
    let rem = size % unit;
    let tenth = (rem * 10) / unit;
    try fmt::append_i64(allocator, out, whole);
    try out.append_byte(allocator, cast<u8>(46));
    try fmt::append_i64(allocator, out, tenth);
    try out.append_bytes(allocator, suffix);
    return;
}

pub fn expand_tilde(
    allocator: Allocator,
    path: []u8,
    home: []u8,
    out: &var string::String,
) -> mem::Error!void {
    if mem::equal_bytes(path, "~") {
        try out.append_bytes(allocator, home);
        return;
    }
    if mem::starts_with(path, "~/") {
        let hlen = mem::len(home);
        if hlen > 0 and home[hlen - 1] == cast<u8>(47) {
            try out.append_bytes(allocator, home[0..hlen - 1]);
        } else {
            try out.append_bytes(allocator, home);
        }
        try out.append_bytes(allocator, path[1..mem::len(path)]);
        return;
    }
    try out.append_bytes(allocator, path);
    return;
}

pub fn is_safe_name(name: []u8) -> bool {
    let length = mem::len(name);
    if length == 0 {
        return false;
    }
    if mem::equal_bytes(name, ".") or mem::equal_bytes(name, "..") {
        return false;
    }
    var i = 0;
    while i < length {
        let b = name[i];
        if b == cast<u8>(47) or b == cast<u8>(0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn is_safe_rel_path(path: []u8) -> bool {
    let length = mem::len(path);
    if length == 0 {
        return false;
    }
    if path[0] == cast<u8>(47) {
        return false;
    }
    var i = 0;
    while i < length {
        if path[i] == cast<u8>(0) {
            return false;
        }
        i = i + 1;
    }
    var start = 0;
    while start < length {
        var end = length;
        if index_of_byte(path, cast<u8>(47), start) |slash| {
            end = slash;
        }
        let seg = path[start..end];
        if mem::equal_bytes(seg, "..") {
            return false;
        }
        if end == length {
            break;
        }
        start = end + 1;
    }
    return true;
}

test "byte helpers" {
    testing::expect(ends_with("foo.tar.gz", ".tar.gz"));
    testing::expect(!ends_with("foo.zip", ".tar.gz"));
    testing::expect(is_valid_sha256_hex("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"));
    testing::expect(!is_valid_sha256_hex("0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef"));
    testing::expect(!is_valid_sha256_hex("short"));

    if parse_byte_size("4GB") |v| {
        testing::expect_equal<i64>(4 * 1024 * 1024 * 1024, v);
    } else {
        testing::fail("expected 4GB to parse");
    }
    if parse_byte_size("512MB") |v| {
        testing::expect_equal<i64>(512 * 1024 * 1024, v);
    } else {
        testing::fail("expected 512MB to parse");
    }
    if parse_byte_size("1024") |v| {
        testing::expect_equal<i64>(1024, v);
    } else {
        testing::fail("expected 1024 to parse");
    }
    if parse_byte_size("0MB") |_| {
        testing::fail("0MB should fail");
    }
    if parse_byte_size("4XB") |_| {
        testing::fail("4XB should fail");
    }

    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if expand_tilde(allocator, "~/.config/nvim", "/test-home", &var out) {} else |_| {
        testing::fail("expand_tilde failed");
        return;
    }
    let expanded = out.as_bytes();
    testing::expect_equal<[]u8>("/test-home/.config/nvim", expanded);

    testing::expect(is_safe_rel_path("bin/rg"));
    testing::expect(!is_safe_rel_path("/etc/passwd"));
    testing::expect(!is_safe_rel_path("a/../b"));
    testing::expect(!is_safe_rel_path("../escape"));
}
