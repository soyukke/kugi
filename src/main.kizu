import kugi::bytes;
import kugi::gc;
import kugi::lockfile;
import kugi::manifest;
import kugi::runtime;
import kugi::store;
import kugi::workspace;
import std;
import std::array;
import std::fmt;
import std::mem;
import std::process;
import std::string;
import std::testing;

const VERSION = "0.1.0";

fn format_version() -> []u8 {
    return VERSION;
}

fn is_version_flag(arg: []u8) -> bool {
    return mem::equal_bytes(arg, "version") or mem::equal_bytes(arg, "--version") or mem::equal_bytes(arg, "-V");
}

fn is_help_flag(arg: []u8) -> bool {
    return mem::equal_bytes(arg, "help") or mem::equal_bytes(arg, "--help") or mem::equal_bytes(arg, "-h");
}

fn write_usage(io: Io) -> std::io::Error!void {
    try std::io::write_stdout_line(io, "kugi - storage-minimal, content-addressed tool & workspace manager");
    try std::io::write_stdout_line(io, "");
    try std::io::write_stdout_line(io, "Usage: kugi <command> [options]");
    try std::io::write_stdout_line(io, "");
    try std::io::write_stdout_line(io, "Commands:");
    try std::io::write_stdout_line(io, "  lock      Resolve tool/asset URLs and write SHA-256 hashes to kugi.lock");
    try std::io::write_stdout_line(io, "  sync      Fetch, verify, extract, and link tools/assets from kugi.lock");
    try std::io::write_stdout_line(io, "  exec      Run a command with manifest tools and env on PATH");
    try std::io::write_stdout_line(io, "  env       Print shell export lines for manifest tools and env");
    try std::io::write_stdout_line(io, "  gc        Prune dead worktree roots and unreferenced store entries");
    try std::io::write_stdout_line(io, "  status    Show resolved tools/assets, store size, and reclaimable space");
    try std::io::write_stdout_line(io, "  version   Print kugi version");
    return;
}

fn write_error_line(io: Io, allocator: Allocator, msg: []u8) -> void {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    out.append_bytes(allocator, "kugi: ") catch return;
    out.append_bytes(allocator, msg) catch return;
    let ob = out.as_bytes();
    let _ = std::io::write_stderr_line(io, ob);
    return;
}

fn workspace_exit_status(err: workspace::Error) -> process::ExitStatus {
    if err == workspace::Error::ManifestInvalid or err == workspace::Error::UsageError {
        return process::ExitStatus::Specific(2);
    }
    return process::ExitStatus::Failure;
}

fn runtime_exit_status(err: runtime::Error) -> process::ExitStatus {
    if err == runtime::Error::ManifestInvalid or err == runtime::Error::UsageError {
        return process::ExitStatus::Specific(2);
    }
    return process::ExitStatus::Failure;
}

fn handle_lock(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var manifest_arg = string::new(allocator);
    defer manifest_arg.deinit(allocator);
    var tool_args = array::new<string::String>(allocator);
    defer tool_args.deinit(allocator);
    var asset_args = array::new<string::String>(allocator);
    defer asset_args.deinit(allocator);
    var target_args = array::new<string::String>(allocator);
    defer target_args.deinit(allocator);
    var sync_after = false;
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if mem::equal_bytes(arg, "--manifest") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--manifest requires a path");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            manifest_arg.clear();
            try manifest_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--tool") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--tool requires a tool name");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            let copy = try string::from_bytes(allocator, val);
            try tool_args.append(allocator, move copy);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--asset") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--asset requires an asset name");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            let copy = try string::from_bytes(allocator, val);
            try asset_args.append(allocator, move copy);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--target") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--target requires <os>-<arch>");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            let copy = try string::from_bytes(allocator, val);
            try target_args.append(allocator, move copy);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--sync") {
            sync_after = true;
            i = i + 1;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi lock [--manifest PATH] [--tool NAME] [--asset NAME] [--target OS-ARCH] [--sync]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "unknown argument for `kugi lock`");
            return process::ExitStatus::Specific(2);
        }
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    var max_size_bytes: i64 = 0;
    let mb = manifest_arg.as_bytes();
    if workspace::run_lock(io, allocator, &paths, mb, &tool_args, &asset_args, &target_args, sync_after, &var max_size_bytes, &var diag) {
        if sync_after and max_size_bytes > 0 {
            let _ = gc::enforce_budget(io, allocator, &paths, max_size_bytes);
        }
        return process::ExitStatus::Success;
    } else |err| {
        let db = diag.as_bytes();
        if mem::len(db) > 0 {
            write_error_line(io, allocator, db);
        } else {
            write_error_line(io, allocator, "lock failed");
        }
        return workspace_exit_status(err);
    }
}

fn handle_sync(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var manifest_arg = string::new(allocator);
    defer manifest_arg.deinit(allocator);
    var force = false;
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if mem::equal_bytes(arg, "--manifest") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--manifest requires a path");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            manifest_arg.clear();
            try manifest_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--force") {
            force = true;
            i = i + 1;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi sync [--manifest PATH] [--force]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "unknown argument for `kugi sync`");
            return process::ExitStatus::Specific(2);
        }
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    var max_size_bytes: i64 = 0;
    let mb = manifest_arg.as_bytes();
    if workspace::run_sync(io, allocator, &paths, mb, force, &var max_size_bytes, &var diag) {
        if max_size_bytes > 0 {
            let _ = gc::enforce_budget(io, allocator, &paths, max_size_bytes);
        }
        return process::ExitStatus::Success;
    } else |err| {
        let db = diag.as_bytes();
        if mem::len(db) > 0 {
            write_error_line(io, allocator, db);
        } else {
            write_error_line(io, allocator, "sync failed");
        }
        return workspace_exit_status(err);
    }
}

fn handle_exec(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var manifest_arg = string::new(allocator);
    defer manifest_arg.deinit(allocator);
    var cmd_args = array::new<string::String>(allocator);
    defer cmd_args.deinit(allocator);
    var saw_dashdash = false;
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if saw_dashdash {
            let copy = try string::from_bytes(allocator, arg);
            try cmd_args.append(allocator, move copy);
            i = i + 1;
            continue;
        }
        if mem::equal_bytes(arg, "--") {
            saw_dashdash = true;
            i = i + 1;
        } else if mem::equal_bytes(arg, "--manifest") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--manifest requires a path");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            manifest_arg.clear();
            try manifest_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi exec [--manifest PATH] -- <cmd> [args...]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "usage: kugi exec [--manifest PATH] -- <cmd> [args...]");
            return process::ExitStatus::Specific(2);
        }
    }
    if !saw_dashdash or cmd_args.len() == 0 {
        write_error_line(io, allocator, "usage: kugi exec [--manifest PATH] -- <cmd> [args...]");
        return process::ExitStatus::Specific(2);
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    let mb = manifest_arg.as_bytes();
    if runtime::run_exec(io, allocator, &paths, mb, &cmd_args, &var diag) {
        return process::ExitStatus::Success;
    } else |err| {
        let db = diag.as_bytes();
        if mem::len(db) > 0 {
            write_error_line(io, allocator, db);
        } else {
            write_error_line(io, allocator, "exec failed");
        }
        return runtime_exit_status(err);
    }
}

fn handle_env(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var manifest_arg = string::new(allocator);
    defer manifest_arg.deinit(allocator);
    var shell_arg = string::new(allocator);
    defer shell_arg.deinit(allocator);
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if mem::equal_bytes(arg, "--manifest") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--manifest requires a path");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            manifest_arg.clear();
            try manifest_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if mem::equal_bytes(arg, "--shell") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--shell requires one of sh, zsh, bash, fish");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            shell_arg.clear();
            try shell_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi env [--manifest PATH] [--shell sh|zsh|bash|fish]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "unknown argument for `kugi env`");
            return process::ExitStatus::Specific(2);
        }
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    let mb = manifest_arg.as_bytes();
    let sb = shell_arg.as_bytes();
    if runtime::run_env(io, allocator, &paths, mb, sb, &var diag) {
        return process::ExitStatus::Success;
    } else |err| {
        let db = diag.as_bytes();
        if mem::len(db) > 0 {
            write_error_line(io, allocator, db);
        } else {
            write_error_line(io, allocator, "env failed");
        }
        return runtime_exit_status(err);
    }
}

fn handle_status(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var manifest_arg = string::new(allocator);
    defer manifest_arg.deinit(allocator);
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if mem::equal_bytes(arg, "--manifest") {
            if i + 1 >= argc {
                write_error_line(io, allocator, "--manifest requires a path");
                return process::ExitStatus::Specific(2);
            }
            let val = try process::arg(i + 1);
            manifest_arg.clear();
            try manifest_arg.append_bytes(allocator, val);
            i = i + 2;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi status [--manifest PATH]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "unknown argument for `kugi status`");
            return process::ExitStatus::Specific(2);
        }
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    let mb = manifest_arg.as_bytes();
    if runtime::run_status(io, allocator, &paths, mb, &var diag) {
        return process::ExitStatus::Success;
    } else |err| {
        let db = diag.as_bytes();
        if mem::len(db) > 0 {
            write_error_line(io, allocator, db);
        } else {
            write_error_line(io, allocator, "status failed");
        }
        return runtime_exit_status(err);
    }
}

fn handle_gc(io: Io, allocator: Allocator, argc: i64) -> !process::ExitStatus {
    var dry_run = false;
    var i: i64 = 1;
    while i < argc {
        let arg = try process::arg(i);
        if mem::equal_bytes(arg, "--dry-run") {
            dry_run = true;
            i = i + 1;
        } else if is_help_flag(arg) {
            try std::io::write_stdout_line(io, "Usage: kugi gc [--dry-run]");
            return process::ExitStatus::Success;
        } else {
            write_error_line(io, allocator, "unknown argument for `kugi gc`");
            return process::ExitStatus::Specific(2);
        }
    }
    var paths = store::resolve_paths(allocator) catch return process::ExitStatus::Failure;
    defer paths.deinit(allocator);
    if gc::run_gc(io, allocator, &paths, dry_run) |report| {
        var line1 = string::new(allocator);
        defer line1.deinit(allocator);
        if dry_run {
            try line1.append_bytes(allocator, "[dry-run] ");
        }
        try line1.append_bytes(allocator, "deleted_roots: ");
        try fmt::append_i64(allocator, &var line1, report.deleted_roots);
        let l1b = line1.as_bytes();
        try std::io::write_stdout_line(io, l1b);

        var line2 = string::new(allocator);
        defer line2.deinit(allocator);
        if dry_run {
            try line2.append_bytes(allocator, "[dry-run] ");
        }
        try line2.append_bytes(allocator, "deleted_store_entries: ");
        try fmt::append_i64(allocator, &var line2, report.deleted_entries);
        let l2b = line2.as_bytes();
        try std::io::write_stdout_line(io, l2b);

        var line3 = string::new(allocator);
        defer line3.deinit(allocator);
        if dry_run {
            try line3.append_bytes(allocator, "[dry-run] ");
        }
        try line3.append_bytes(allocator, "freed_bytes: ");
        try bytes::format_byte_size(allocator, &var line3, report.freed_bytes);
        let l3b = line3.as_bytes();
        try std::io::write_stdout_line(io, l3b);
        return process::ExitStatus::Success;
    } else |_| {
        write_error_line(io, allocator, "gc failed");
        return process::ExitStatus::Failure;
    }
}

fn main() -> !process::ExitStatus {
    let io = std::io::blocking();
    let allocator = mem::page_allocator();
    let count = process::arg_count();
    if count == 0 {
        try write_usage(io);
        return process::ExitStatus::Success;
    }

    let first = try process::arg(0);
    if is_version_flag(first) {
        try std::io::write_stdout_line(io, format_version());
        return process::ExitStatus::Success;
    }
    if is_help_flag(first) {
        try write_usage(io);
        return process::ExitStatus::Success;
    }
    if mem::equal_bytes(first, "lock") {
        return handle_lock(io, allocator, count);
    }
    if mem::equal_bytes(first, "sync") {
        return handle_sync(io, allocator, count);
    }
    if mem::equal_bytes(first, "exec") {
        return handle_exec(io, allocator, count);
    }
    if mem::equal_bytes(first, "env") {
        return handle_env(io, allocator, count);
    }
    if mem::equal_bytes(first, "gc") {
        return handle_gc(io, allocator, count);
    }
    if mem::equal_bytes(first, "status") {
        return handle_status(io, allocator, count);
    }

    write_error_line(io, allocator, "unknown command (run `kugi --help`)");
    return process::ExitStatus::Specific(2);
}

test "cli flags" {
    testing::expect(is_version_flag("version"));
    testing::expect(is_version_flag("--version"));
    testing::expect(is_version_flag("-V"));
    testing::expect(!is_version_flag("sync"));
    testing::expect(is_help_flag("help"));
    testing::expect(is_help_flag("--help"));
    testing::expect(is_help_flag("-h"));
    testing::expect_equal<[]u8>("0.1.0", format_version());
}

test "manifest and lockfile integration" {
    let allocator = mem::page_allocator();
    let doc =
        \\[tools.demo]
        \\version = "1.0.0"
        \\url = "https://example.com/demo-{version}-{os}-{arch}.tar.gz"
        \\bin = ["demo"]
    ;
    var diag = string::new(allocator);
    defer diag.deinit(allocator);
    if manifest::parse(allocator, doc, &var diag) |m| {
        defer m.deinit(allocator);
        testing::expect_equal<i64>(1, m.tools.len());
        testing::expect(bytes::is_safe_name("demo"));
        var lf = lockfile::new_lockfile(allocator);
        defer lf.deinit(allocator);
        testing::expect_equal<i64>(1, lf.version);
        var sk = string::new(allocator);
        defer sk.deinit(allocator);
        if store::format_store_key(allocator, "demo", "1.0.0", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", &var sk) {
            let skb = sk.as_bytes();
            testing::expect_equal<[]u8>("demo-1.0.0-0123456789ab", skb);
        } else |_| {
            testing::fail("format_store_key failed");
        }
    } else |_| {
        testing::fail("manifest parse failed");
    }
}
