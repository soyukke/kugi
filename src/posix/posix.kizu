import kugi::bytes;
import kugi::hash;
import std::array;
import std::fmt;
import std::fs;
import std::io;
import std::mem;
import std::path;
import std::process;
import std::string;
import std::testing;

pub error Error {
    InvalidPath,
    NotFound,
    AlreadyExists,
    NotSymlink,
    IoFailed,
    ExecFailed,
    UnsupportedArch,
    OutOfMemory,
}

pub enum PathKind {
    Missing,
    Symlink,
    File,
    Dir,
}

pub struct FileLock {
    pub fd: i32,
}

extern "c" fn open(path: ptr<const u8>, oflag: i32, ...) -> i32
extern "c" fn close(fd: i32) -> i32
extern "c" fn read(fd: i32, buf: ptr<u8>, count: usize) -> isize
extern "c" fn write(fd: i32, buf: ptr<const u8>, count: usize) -> isize
extern "c" fn flock(fd: i32, operation: i32) -> i32
extern "c" fn symlink(target: ptr<const u8>, linkpath: ptr<const u8>) -> i32
extern "c" fn link(oldpath: ptr<const u8>, newpath: ptr<const u8>) -> i32
extern "c" fn readlink(path: ptr<const u8>, buf: ptr<u8>, bufsiz: usize) -> isize
extern "c" fn chmod(path: ptr<const u8>, mode: u32) -> i32
extern "c" fn unlink(path: ptr<const u8>) -> i32
extern "c" fn rmdir(path: ptr<const u8>) -> i32
extern "c" fn rename(oldpath: ptr<const u8>, newpath: ptr<const u8>) -> i32
extern "c" fn getcwd(buf: ptr<u8>, size: usize) -> ?ptr<u8>
extern "c" fn getpid() -> i32
extern "c" fn setenv(name: ptr<const u8>, value: ptr<const u8>, overwrite: i32) -> i32
extern "c" fn utimes(path: ptr<const u8>, times: ?ptr<const u8>) -> i32
extern "c" fn execvp(file: ptr<const u8>, argv: ptr<const usize>) -> i32
extern "c" fn pipe(fds: ptr<i32>) -> i32
extern "c" fn fork() -> i32
extern "c" fn dup2(oldfd: i32, newfd: i32) -> i32
extern "c" fn _exit(status: i32) -> void
extern "c" fn waitpid(pid: i32, status: ptr<i32>, options: i32) -> i32
extern "c" fn __error() -> ptr<i32>
extern "c" fn __errno_location() -> ptr<i32>
fn last_errno() -> i32 {
    comptime if std::target::is_darwin() {
        return unsafe ptr_read(unsafe __error());
    } else {
        return unsafe ptr_read(unsafe __errno_location());
    }
}

fn o_rdonly() -> i32 {
    return 0;
}

fn o_wronly() -> i32 {
    return 1;
}

fn o_rdwr() -> i32 {
    return 2;
}

fn o_creat() -> i32 {
    comptime if std::target::is_darwin() {
        return 512;
    } else {
        return 64;
    }
}

fn o_trunc() -> i32 {
    comptime if std::target::is_darwin() {
        return 1024;
    } else {
        return 512;
    }
}

fn make_cstr(allocator: Allocator, text: []u8) -> Error!string::String {
    if bytes::index_of_byte(text, cast<u8>(0), 0) |_| {
        return Error::InvalidPath;
    }
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    out.append_bytes(allocator, text) catch return Error::OutOfMemory;
    out.append_byte(allocator, cast<u8>(0)) catch return Error::OutOfMemory;
    return move out;
}

pub fn pid() -> i64 {
    return cast<i64>(unsafe getpid());
}

pub fn detect_os() -> []u8 {
    comptime if std::target::is_darwin() {
        return "darwin";
    } else {
        return "linux";
    }
}

pub fn detect_arch(allocator: Allocator, out: &var string::String) -> Error!void {
    var raw = string::new(allocator);
    defer raw.deinit(allocator);
    let code = process::spawn_output8(
        allocator,
        &var raw,
        2,
        "uname",
        "-m",
        "",
        "",
        "",
        "",
        "",
        "",
    ) catch return Error::IoFailed;
    if code != 0 {
        return Error::UnsupportedArch;
    }
    let raw_bytes = raw.as_bytes();
    let trimmed = mem::trim_ascii(raw_bytes);
    if mem::equal_bytes(trimmed, "arm64") or mem::equal_bytes(trimmed, "aarch64") {
        out.append_bytes(allocator, "aarch64") catch return Error::OutOfMemory;
        return;
    }
    if mem::equal_bytes(trimmed, "x86_64") or mem::equal_bytes(trimmed, "amd64") {
        out.append_bytes(allocator, "x86_64") catch return Error::OutOfMemory;
        return;
    }
    return Error::UnsupportedArch;
}

pub fn get_cwd(allocator: Allocator, out: &var string::String) -> Error!void {
    var buf = [4096]u8{};
    let view = buf.as_mut_bytes();
    let res = unsafe getcwd(mut_ptr_of(view), cast<usize>(4096));
    if res |_| {
        let ro = buf.as_bytes();
        var len = 0;
        while len < 4096 and ro[len] != cast<u8>(0) {
            len = len + 1;
        }
        out.append_bytes(allocator, ro[0..len]) catch return Error::OutOfMemory;
        return;
    }
    return Error::IoFailed;
}

pub fn open_read(allocator: Allocator, path_bytes: []u8) -> Error!i32 {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let fd = unsafe open(ptr_of(cb), o_rdonly());
    if fd < 0 {
        if last_errno() == 2 {
            return Error::NotFound;
        }
        return Error::IoFailed;
    }
    return fd;
}

pub fn open_write_trunc(allocator: Allocator, path_bytes: []u8) -> Error!i32 {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let flags = o_wronly() | o_creat() | o_trunc();
    let fd = unsafe open(ptr_of(cb), flags, cast<i32>(420));
    if fd < 0 {
        return Error::IoFailed;
    }
    return fd;
}

pub fn close_fd(fd: i32) -> void {
    if fd >= 0 {
        let _ = unsafe close(fd);
    }
    return;
}

pub fn read_fd(fd: i32, buf: &var []u8) -> Error!i64 {
    let cap = mem::len(buf);
    while true {
        let n = unsafe read(fd, mut_ptr_of(buf), cast<usize>(cap));
        if n >= 0 {
            return cast<i64>(n);
        }
        if last_errno() != 4 {
            return Error::IoFailed;
        }
    }
    return Error::IoFailed;
}

pub fn write_all_fd(fd: i32, data: []u8) -> Error!void {
    let total = mem::len(data);
    var written: i64 = 0;
    while written < total {
        let slice = data[written..total];
        let rem = total - written;
        let n = unsafe write(fd, ptr_of(slice), cast<usize>(rem));
        if n > 0 {
            written = written + cast<i64>(n);
        } else if n < 0 and last_errno() == 4 {
            continue;
        } else {
            return Error::IoFailed;
        }
    }
    return;
}

pub fn hash_file_sha256(
    allocator: Allocator,
    file_path: []u8,
    out: &var string::String,
) -> Error!void {
    let fd = try open_read(allocator, file_path);
    var buf = [16384]u8{};
    var hasher = hash::stream_new();
    while true {
        let view = buf.as_mut_bytes();
        var got: i64 = 0;
        if read_fd(fd, view) |n| {
            got = n;
        } else |err| {
            close_fd(fd);
            return err;
        }
        if got == 0 {
            break;
        }
        let ro = buf.as_bytes();
        hash::stream_update(&var hasher, ro[0..got]);
    }
    close_fd(fd);
    hash::stream_finish_hex(allocator, &var hasher, out) catch return Error::OutOfMemory;
    return;
}

pub fn copy_file_streaming(
    allocator: Allocator,
    src: []u8,
    dst: []u8,
) -> Error!void {
    let in_fd = try open_read(allocator, src);
    var out_fd: i32 = -1;
    if open_write_trunc(allocator, dst) |fd| {
        out_fd = fd;
    } else |err| {
        close_fd(in_fd);
        return err;
    }
    var buf = [16384]u8{};
    while true {
        let view = buf.as_mut_bytes();
        var got: i64 = 0;
        if read_fd(in_fd, view) |n| {
            got = n;
        } else |err| {
            close_fd(in_fd);
            close_fd(out_fd);
            let _ = unlink_if_exists(allocator, dst);
            return err;
        }
        if got == 0 {
            break;
        }
        let ro = buf.as_bytes();
        if write_all_fd(out_fd, ro[0..got]) {} else |err| {
            close_fd(in_fd);
            close_fd(out_fd);
            let _ = unlink_if_exists(allocator, dst);
            return err;
        }
    }
    close_fd(in_fd);
    close_fd(out_fd);
    return;
}

pub fn acquire_exclusive_lock(allocator: Allocator, lock_path: []u8) -> Error!FileLock {
    var cpath = try make_cstr(allocator, lock_path);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let flags = o_rdwr() | o_creat();
    let fd = unsafe open(ptr_of(cb), flags, cast<i32>(420));
    if fd < 0 {
        return Error::IoFailed;
    }
    while true {
        let rc = unsafe flock(fd, 2);
        if rc == 0 {
            return FileLock { fd: fd };
        }
        if last_errno() != 4 {
            close_fd(fd);
            return Error::IoFailed;
        }
    }
    close_fd(fd);
    return Error::IoFailed;
}

pub fn try_acquire_exclusive_lock(allocator: Allocator, lock_path: []u8) -> Error!?FileLock {
    var cpath = try make_cstr(allocator, lock_path);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let flags = o_rdwr() | o_creat();
    let fd = unsafe open(ptr_of(cb), flags, cast<i32>(420));
    if fd < 0 {
        return Error::IoFailed;
    }
    let rc = unsafe flock(fd, 6);
    if rc == 0 {
        return FileLock { fd: fd };
    }
    let err = last_errno();
    close_fd(fd);
    if err == 35 or err == 11 {
        return null;
    }
    return Error::IoFailed;
}

pub fn release_lock(lock: &var FileLock) -> void {
    if lock.fd >= 0 {
        let _ = unsafe flock(lock.fd, 8);
        close_fd(lock.fd);
        lock.fd = -1;
    }
    return;
}

pub fn read_symlink(
    allocator: Allocator,
    path_bytes: []u8,
    out: &var string::String,
) -> Error!bool {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    var buf = [4096]u8{};
    let view = buf.as_mut_bytes();
    let n = unsafe readlink(ptr_of(cb), mut_ptr_of(view), cast<usize>(4096));
    if n < 0 {
        let err = last_errno();
        if err == 2 or err == 22 or err == 20 {
            return false;
        }
        return Error::IoFailed;
    }
    let ro = buf.as_bytes();
    out.append_bytes(allocator, ro[0..cast<i64>(n)]) catch return Error::OutOfMemory;
    return true;
}

pub fn inspect_path(
    handle: Io,
    allocator: Allocator,
    path_bytes: []u8,
) -> Error!PathKind {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    var buf = [4]u8{};
    let view = buf.as_mut_bytes();
    let n = unsafe readlink(ptr_of(cb), mut_ptr_of(view), cast<usize>(4));
    if n >= 0 {
        return PathKind::Symlink;
    }
    let err = last_errno();
    if err == 2 or err == 20 {
        return PathKind::Missing;
    }
    if fs::metadata(handle, path_bytes) |meta| {
        if meta.is_dir {
            return PathKind::Dir;
        }
        return PathKind::File;
    } else |_| {
        return PathKind::Missing;
    }
}

pub fn create_symlink(
    allocator: Allocator,
    target: []u8,
    linkpath: []u8,
) -> Error!void {
    var ctarget = try make_cstr(allocator, target);
    defer ctarget.deinit(allocator);
    var clink = try make_cstr(allocator, linkpath);
    defer clink.deinit(allocator);
    let tb = ctarget.as_bytes();
    let lb = clink.as_bytes();
    let rc = unsafe symlink(ptr_of(tb), ptr_of(lb));
    if rc != 0 {
        if last_errno() == 17 {
            return Error::AlreadyExists;
        }
        return Error::IoFailed;
    }
    return;
}

pub fn atomic_symlink(
    allocator: Allocator,
    target: []u8,
    linkpath: []u8,
    nonce: []u8,
) -> Error!void {
    var tmp_link = string::new(allocator);
    defer tmp_link.deinit(allocator);
    tmp_link.append_bytes(allocator, linkpath) catch return Error::OutOfMemory;
    tmp_link.append_bytes(allocator, ".kugi-link.") catch return Error::OutOfMemory;
    tmp_link.append_bytes(allocator, nonce) catch return Error::OutOfMemory;
    let tmp_bytes = tmp_link.as_bytes();
    try create_symlink(allocator, target, tmp_bytes);
    if rename_path(allocator, tmp_bytes, linkpath) {
        return;
    } else |err| {
        let _ = unlink_if_exists(allocator, tmp_bytes);
        return err;
    }
}

pub fn hardlink_no_clobber(
    allocator: Allocator,
    src: []u8,
    dst: []u8,
) -> Error!bool {
    var csrc = try make_cstr(allocator, src);
    defer csrc.deinit(allocator);
    var cdst = try make_cstr(allocator, dst);
    defer cdst.deinit(allocator);
    let sb = csrc.as_bytes();
    let db = cdst.as_bytes();
    let rc = unsafe link(ptr_of(sb), ptr_of(db));
    if rc == 0 {
        return true;
    }
    if last_errno() == 17 {
        return false;
    }
    return Error::IoFailed;
}

pub fn set_executable(allocator: Allocator, path_bytes: []u8) -> Error!void {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let rc = unsafe chmod(ptr_of(cb), cast<u32>(493));
    if rc != 0 {
        return Error::IoFailed;
    }
    return;
}

pub fn touch_now(allocator: Allocator, path_bytes: []u8) -> void {
    if make_cstr(allocator, path_bytes) |cpath| {
        defer cpath.deinit(allocator);
        let cb = cpath.as_bytes();
        let _ = unsafe utimes(ptr_of(cb), null);
    } else |_| {}
    return;
}

pub fn unlink_if_exists(allocator: Allocator, path_bytes: []u8) -> Error!void {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let rc = unsafe unlink(ptr_of(cb));
    if rc != 0 {
        if last_errno() == 2 {
            return;
        }
        return Error::IoFailed;
    }
    return;
}

pub fn remove_empty_dir(allocator: Allocator, path_bytes: []u8) -> Error!void {
    var cpath = try make_cstr(allocator, path_bytes);
    defer cpath.deinit(allocator);
    let cb = cpath.as_bytes();
    let rc = unsafe rmdir(ptr_of(cb));
    if rc != 0 {
        if last_errno() == 2 {
            return;
        }
        return Error::IoFailed;
    }
    return;
}

pub fn rename_path(allocator: Allocator, oldpath: []u8, newpath: []u8) -> Error!void {
    var cold = try make_cstr(allocator, oldpath);
    defer cold.deinit(allocator);
    var cnew = try make_cstr(allocator, newpath);
    defer cnew.deinit(allocator);
    let ob = cold.as_bytes();
    let nb = cnew.as_bytes();
    let rc = unsafe rename(ptr_of(ob), ptr_of(nb));
    if rc != 0 {
        return Error::IoFailed;
    }
    return;
}

pub fn set_env(allocator: Allocator, name: []u8, value: []u8) -> Error!void {
    var cname = try make_cstr(allocator, name);
    defer cname.deinit(allocator);
    var cval = try make_cstr(allocator, value);
    defer cval.deinit(allocator);
    let nb = cname.as_bytes();
    let vb = cval.as_bytes();
    let rc = unsafe setenv(ptr_of(nb), ptr_of(vb), 1);
    if rc != 0 {
        return Error::IoFailed;
    }
    return;
}

pub fn exec_replace(
    allocator: Allocator,
    args: &array::Array<string::String>,
) -> Error!void {
    if args.len() == 0 {
        return Error::ExecFailed;
    }
    var cstrings = array::new<string::String>(allocator);
    defer cstrings.deinit(allocator);
    var i = 0;
    while args.at(i) |arg| {
        let ab = arg.as_bytes();
        let cs = try make_cstr(allocator, ab);
        cstrings.append(allocator, move cs) catch return Error::OutOfMemory;
        i = i + 1;
    }
    var ptrs = array::new<usize>(allocator);
    defer ptrs.deinit(allocator);
    var j = 0;
    while cstrings.at(j) |cs| {
        let cb = cs.as_bytes();
        let addr = unsafe int_from_ptr<usize>(ptr_of(cb));
        ptrs.append(allocator, addr) catch return Error::OutOfMemory;
        j = j + 1;
    }
    ptrs.append(allocator, cast<usize>(0)) catch return Error::OutOfMemory;
    let argv_slice = ptrs.as_slice();
    if cstrings.at(0) |prog| {
        let pb = prog.as_bytes();
        let _ = unsafe execvp(ptr_of(pb), ptr_of(argv_slice));
    }
    return Error::ExecFailed;
}

pub fn spawn_capture_stdout(
    allocator: Allocator,
    args: &array::Array<string::String>,
    out_stdout: &var string::String,
) -> Error!i64 {
    if args.len() == 0 {
        return Error::ExecFailed;
    }
    var cstrings = array::new<string::String>(allocator);
    defer cstrings.deinit(allocator);
    var i = 0;
    while args.at(i) |arg| {
        let ab = arg.as_bytes();
        let cs = try make_cstr(allocator, ab);
        cstrings.append(allocator, move cs) catch return Error::OutOfMemory;
        i = i + 1;
    }
    var ptrs = array::new<usize>(allocator);
    defer ptrs.deinit(allocator);
    var j = 0;
    while cstrings.at(j) |cs| {
        let cb = cs.as_bytes();
        let addr = unsafe int_from_ptr<usize>(ptr_of(cb));
        ptrs.append(allocator, addr) catch return Error::OutOfMemory;
        j = j + 1;
    }
    ptrs.append(allocator, cast<usize>(0)) catch return Error::OutOfMemory;
    let argv_slice = ptrs.as_slice();
    var devnull = try make_cstr(allocator, "/dev/null");
    defer devnull.deinit(allocator);
    let devnull_b = devnull.as_bytes();

    var fds = [2]i32{};
    let fds_view = fds.as_mut_slice();
    if unsafe pipe(mut_ptr_of(fds_view)) != 0 {
        return Error::IoFailed;
    }
    let read_end = fds[0];
    let write_end = fds[1];

    let child_pid = unsafe fork();
    if child_pid < 0 {
        close_fd(read_end);
        close_fd(write_end);
        return Error::ExecFailed;
    }
    if child_pid == 0 {
        close_fd(read_end);
        if write_end != 1 {
            let _ = unsafe dup2(write_end, 1);
            close_fd(write_end);
        }
        let null_fd = unsafe open(ptr_of(devnull_b), o_rdwr());
        if null_fd >= 0 {
            if null_fd != 0 {
                let _ = unsafe dup2(null_fd, 0);
            }
            if null_fd != 2 {
                let _ = unsafe dup2(null_fd, 2);
            }
            if null_fd > 2 {
                close_fd(null_fd);
            }
        }
        if cstrings.at(0) |prog| {
            let pb = prog.as_bytes();
            let _ = unsafe execvp(ptr_of(pb), ptr_of(argv_slice));
        }
        unsafe _exit(127);
    }

    close_fd(write_end);
    var read_failed = false;
    var oom_failed = false;
    var buf = [4096]u8{};
    while true {
        let view = buf.as_mut_bytes();
        var got: i64 = 0;
        if read_fd(read_end, view) |n| {
            got = n;
        } else |_| {
            read_failed = true;
            break;
        }
        if got == 0 {
            break;
        }
        let ro = buf.as_bytes();
        if out_stdout.append_bytes(allocator, ro[0..got]) {} else |_| {
            oom_failed = true;
            break;
        }
    }
    close_fd(read_end);

    var status_buf = [1]i32{};
    let status_view = status_buf.as_mut_slice();
    while true {
        let waited = unsafe waitpid(child_pid, mut_ptr_of(status_view), 0);
        if waited >= 0 {
            break;
        }
        if last_errno() != 4 {
            return Error::IoFailed;
        }
    }
    if oom_failed {
        return Error::OutOfMemory;
    }
    if read_failed {
        return Error::IoFailed;
    }
    let raw_status = status_buf[0];
    let sig = raw_status & 127;
    if sig == 0 {
        return cast<i64>((raw_status >> 8) & 255);
    }
    return cast<i64>(128 + sig);
}

pub fn create_dir_all(
    handle: Io,
    allocator: Allocator,
    dir_path: []u8,
) -> Error!void {
    let cleaned = path::clean(allocator, dir_path) catch return Error::OutOfMemory;
    defer cleaned.deinit(allocator);
    let cb = cleaned.as_bytes();
    let length = mem::len(cb);
    if length == 0 or mem::equal_bytes(cb, ".") or mem::equal_bytes(cb, "/") {
        return;
    }
    var pos = 0;
    if cb[0] == cast<u8>(47) {
        pos = 1;
    }
    while pos <= length {
        var end = length;
        if bytes::index_of_byte(cb, cast<u8>(47), pos) |slash| {
            end = slash;
        }
        let prefix = cb[0..end];
        if mem::len(prefix) > 0 {
            if fs::create_dir(handle, prefix) {} else |_| {
                let kind = try inspect_path(handle, allocator, prefix);
                if kind != PathKind::Dir {
                    if fs::metadata(handle, prefix) |meta| {
                        if !meta.is_dir {
                            return Error::IoFailed;
                        }
                    } else |_| {
                        return Error::IoFailed;
                    }
                }
            }
        }
        if end == length {
            break;
        }
        pos = end + 1;
    }
    return;
}

pub fn remove_tree(
    handle: Io,
    allocator: Allocator,
    target: []u8,
) -> Error!void {
    let kind = try inspect_path(handle, allocator, target);
    if kind == PathKind::Missing {
        return;
    }
    if kind == PathKind::Symlink or kind == PathKind::File {
        return unlink_if_exists(allocator, target);
    }
    var entries = fs::read_dir(handle, allocator, target) catch return Error::IoFailed;
    defer entries.deinit(allocator);
    var i = 0;
    while entries.at(i) |entry| {
        let ep = entry.path.as_bytes();
        try remove_tree(handle, allocator, ep);
        i = i + 1;
    }
    return remove_empty_dir(allocator, target);
}

pub fn tree_size_bytes(
    handle: Io,
    allocator: Allocator,
    target: []u8,
) -> Error!i64 {
    let kind = try inspect_path(handle, allocator, target);
    if kind == PathKind::Missing or kind == PathKind::Symlink {
        return 0;
    }
    if kind == PathKind::File {
        if fs::metadata(handle, target) |meta| {
            return meta.size;
        } else |_| {
            return 0;
        }
    }
    var total: i64 = 0;
    var entries = fs::read_dir(handle, allocator, target) catch return 0;
    defer entries.deinit(allocator);
    var i = 0;
    while entries.at(i) |entry| {
        let ep = entry.path.as_bytes();
        let child = try tree_size_bytes(handle, allocator, ep);
        total = total + child;
        i = i + 1;
    }
    return total;
}

pub fn path_mtime_secs(allocator: Allocator, target: []u8) -> Error!i64 {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    var flag: []u8 = "-c";
    var fmt_arg: []u8 = "%Y";
    comptime if std::target::is_darwin() {
        flag = "-f";
        fmt_arg = "%m";
    }
    let code = process::spawn_output8(
        allocator,
        &var out,
        4,
        "stat",
        flag,
        fmt_arg,
        target,
        "",
        "",
        "",
        "",
    ) catch return Error::IoFailed;
    if code != 0 {
        return Error::IoFailed;
    }
    let out_bytes = out.as_bytes();
    let trimmed = mem::trim_ascii(out_bytes);
    let secs = bytes::parse_nonneg_i64(trimmed) orelse return Error::IoFailed;
    return secs;
}

pub fn write_file_atomic(
    handle: Io,
    allocator: Allocator,
    target: []u8,
    content: []u8,
    nonce: []u8,
) -> Error!void {
    let parent = path::dirname(target);
    if mem::len(parent) > 0 and !mem::equal_bytes(parent, ".") {
        try create_dir_all(handle, allocator, parent);
    }
    var tmp_path = string::new(allocator);
    defer tmp_path.deinit(allocator);
    tmp_path.append_bytes(allocator, target) catch return Error::OutOfMemory;
    tmp_path.append_bytes(allocator, ".tmp.") catch return Error::OutOfMemory;
    tmp_path.append_bytes(allocator, nonce) catch return Error::OutOfMemory;
    let tb = tmp_path.as_bytes();
    let fd = try open_write_trunc(allocator, tb);
    if write_all_fd(fd, content) {
        close_fd(fd);
    } else |err| {
        close_fd(fd);
        let _ = unlink_if_exists(allocator, tb);
        return err;
    }
    if rename_path(allocator, tb, target) {
        return;
    } else |err| {
        let _ = unlink_if_exists(allocator, tb);
        return err;
    }
}

test "posix flock symlink hardlink and tree helpers" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var base = string::new(allocator);
    defer base.deinit(allocator);
    let tmp_root = process::env("TMPDIR") orelse "/tmp";
    base.append_bytes(allocator, tmp_root) catch return;
    base.append_bytes(allocator, "/kugi-posix-test-") catch return;
    fmt::append_i64(allocator, &var base, pid()) catch return;
    base.append_bytes(allocator, "-") catch return;
    fmt::append_i64(allocator, &var base, process::unix_millis()) catch return;
    let base_bytes = base.as_bytes();

    if create_dir_all(handle, allocator, base_bytes) {} else |_| {
        testing::fail("create_dir_all failed");
        return;
    }

    var lock_file = path::join(allocator, base_bytes, "test.lock") catch return;
    defer lock_file.deinit(allocator);
    let lf_bytes = lock_file.as_bytes();
    if acquire_exclusive_lock(allocator, lf_bytes) |lk1| {
        var guard1 = lk1;
        if try_acquire_exclusive_lock(allocator, lf_bytes) |maybe_lk2| {
            if maybe_lk2 |lk2| {
                var guard2 = lk2;
                release_lock(&var guard2);
                release_lock(&var guard1);
                testing::fail("non-blocking flock should fail while locked");
            }
        } else |_| {
            release_lock(&var guard1);
            testing::fail("try_acquire_exclusive_lock returned error");
        }
        release_lock(&var guard1);
        if try_acquire_exclusive_lock(allocator, lf_bytes) |maybe_lk3| {
            if maybe_lk3 |lk3| {
                var guard3 = lk3;
                release_lock(&var guard3);
            } else {
                testing::fail("flock should succeed after release");
            }
        } else |_| {
            testing::fail("try_acquire_exclusive_lock after release errored");
        }
    } else |_| {
        testing::fail("acquire_exclusive_lock failed");
    }

    var target_file = path::join(allocator, base_bytes, "hello.txt") catch return;
    defer target_file.deinit(allocator);
    let tf_bytes = target_file.as_bytes();
    if write_file_atomic(handle, allocator, tf_bytes, "hello", "1") {} else |_| {
        testing::fail("write_file_atomic failed");
    }

    var link_path = path::join(allocator, base_bytes, "link.txt") catch return;
    defer link_path.deinit(allocator);
    let lp_bytes = link_path.as_bytes();
    if atomic_symlink(allocator, tf_bytes, lp_bytes, "1") {} else |_| {
        testing::fail("atomic_symlink failed");
    }
    if inspect_path(handle, allocator, lp_bytes) |kind| {
        testing::expect(kind == PathKind::Symlink);
    } else |_| {
        testing::fail("inspect_path symlink failed");
    }
    var read_back = string::new(allocator);
    defer read_back.deinit(allocator);
    if read_symlink(allocator, lp_bytes, &var read_back) |ok| {
        testing::expect(ok);
        let rb = read_back.as_bytes();
        testing::expect_equal<[]u8>(tf_bytes, rb);
    } else |_| {
        testing::fail("read_symlink failed");
    }

    var no_clobber_dst = path::join(allocator, base_bytes, "existing.bin") catch return;
    defer no_clobber_dst.deinit(allocator);
    let ncb = no_clobber_dst.as_bytes();
    if write_file_atomic(handle, allocator, ncb, "original", "2") {} else |_| {
        testing::fail("write existing failed");
    }
    if hardlink_no_clobber(allocator, tf_bytes, ncb) |installed| {
        testing::expect(!installed);
    } else |_| {
        testing::fail("hardlink_no_clobber errored");
    }

    var arch_out = string::new(allocator);
    defer arch_out.deinit(allocator);
    if detect_arch(allocator, &var arch_out) {
        let ab = arch_out.as_bytes();
        testing::expect(mem::equal_bytes(ab, "aarch64") or mem::equal_bytes(ab, "x86_64"));
    } else |_| {
        testing::fail("detect_arch failed");
    }

    if remove_tree(handle, allocator, base_bytes) {} else |_| {
        testing::fail("remove_tree cleanup failed");
    }
}

test "posix spawn_capture_stdout handles more than 8 arguments and exit codes" {
    let allocator = mem::page_allocator();
    var args = array::new<string::String>(allocator);
    defer args.deinit(allocator);
    let a0 = string::from_bytes(allocator, "printf") catch return;
    args.append(allocator, move a0) catch return;
    let a1 = string::from_bytes(allocator, "%s-%s-%s-%s-%s-%s-%s-%s-%s") catch return;
    args.append(allocator, move a1) catch return;
    for 1..10 |idx| {
        var num = string::new(allocator);
        if fmt::append_i64(allocator, &var num, idx) {} else |_| {
            num.deinit(allocator);
            return;
        }
        args.append(allocator, move num) catch return;
    }
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if spawn_capture_stdout(allocator, &args, &var out) |rc| {
        testing::expect_equal<i64>(0, rc);
        let ob = out.as_bytes();
        testing::expect_equal<[]u8>("1-2-3-4-5-6-7-8-9", ob);
    } else |_| {
        testing::fail("spawn_capture_stdout printf failed");
    }

    var fail_args = array::new<string::String>(allocator);
    defer fail_args.deinit(allocator);
    let false_cmd = string::from_bytes(allocator, "false") catch return;
    fail_args.append(allocator, move false_cmd) catch return;
    var fail_out = string::new(allocator);
    defer fail_out.deinit(allocator);
    if spawn_capture_stdout(allocator, &fail_args, &var fail_out) |rc| {
        testing::expect(rc != 0);
    } else |_| {
        testing::fail("spawn_capture_stdout false errored");
    }
}
